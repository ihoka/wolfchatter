<%# locals: (chatroom:, message: nil) %>
<% message ||= Message.new(chatroom: chatroom) %>
<%= form_with model: message, scope: :message, url: chatroom_messages_path(chatroom),
      id: dom_id(chatroom, :message_form), class: "mt-2 space-y-2" do |form| %>
  <% message.errors.full_messages.each do |error| %>
    <p role="alert" class="text-sm text-red-700"><%= error %></p>
  <% end %>
  <%= form.text_field :body, value: message.body, placeholder: "write message here",
        maxlength: Message::MAX_BODY_LENGTH, required: true, autocomplete: "off", aria: { label: "write message here" },
        class: "w-full rounded border px-2 py-1" %>
  <%= form.submit "Submit", class: "rounded bg-blue-700 px-3 py-1 text-white" %>
<% end %>
