<div id="map_container" data-turbo-permanent
     data-controller="map"
     data-action="marker:connect@window->map#register"
     data-map-tile-url-value="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
     data-map-attribution-value="&copy; <a href='https://www.openstreetmap.org/copyright'>OpenStreetMap</a> contributors"
     data-map-center-value="[20, 0]"
     data-map-zoom-value="2"
     data-map-icon-url-value="<%= image_path("leaflet/marker-icon.png") %>"
     data-map-icon-retina-url-value="<%= image_path("leaflet/marker-icon-2x.png") %>"
     data-map-shadow-url-value="<%= image_path("leaflet/marker-shadow.png") %>">
  <div id="map" role="region" aria-label="Chat map" class="fixed inset-0 z-0" data-map-target="map"></div>
  <div id="markers" hidden>
    <%= render partial: "chatrooms/marker", collection: chatrooms, as: :chatroom %>
  </div>
  <%= form_with url: chatrooms_path, id: "new_chatroom_form", hidden: true, data: { turbo_frame: "chatroom_panel", map_target: "form" } do |form| %>
    <%= form.hidden_field "chatroom[latitude]", id: "chatroom_latitude", data: { map_target: "latitude" } %>
    <%= form.hidden_field "chatroom[longitude]", id: "chatroom_longitude", data: { map_target: "longitude" } %>
  <% end %>
</div>

<turbo-frame id="chatroom_panel" data-turbo-action="advance" class="fixed top-4 right-4 z-[1000] w-96 max-w-[calc(100vw-2rem)] bg-white rounded shadow">
  <% if chatroom %>
    <%= render "chatrooms/panel", chatroom: chatroom %>
  <% else %>
    <%= render "chatrooms/empty_panel" %>
  <% end %>
</turbo-frame>
