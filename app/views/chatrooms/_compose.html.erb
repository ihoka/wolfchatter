<%# locals: (chatroom:, display_name: nil) %>
<div id="<%= dom_id(chatroom, :compose) %>" class="border-t p-4">
  <% name = current_display_name %>
  <% if name.present? && (display_name.nil? || display_name.errors.empty?) %>
    <p class="text-sm">
      Chatting as <strong><%= name %></strong>
      <%= button_to "change", display_name_path(chatroom_id: chatroom.id), method: :delete,
            form: { class: "inline" }, class: "ml-2 text-blue-700 underline" %>
    </p>
    <%= render "messages/form", chatroom: chatroom %>
  <% else %>
    <%= render "display_names/form", chatroom: chatroom, display_name: display_name || DisplayName.new %>
  <% end %>
</div>
